# ==============================================================================
# Chatible Root Environment Configuration (Production Template)
# ==============================================================================

PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Apply schema changes before deployment: npm run db:migrate
DATABASE_URL=postgresql://chatible_user:chatible_password@localhost:5432/chatible_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
ADMIN_JWT_SECRET=replace_with_a_separate_secure_admin_jwt_secret_at_least_32_chars_long
GOOGLE_CLIENT_ID=your_google_oauth_client_id
ADMIN_SECRET_TOKEN=replace_with_a_unique_random_secret
# Required Base32 (>=16 chars) secret in production for Super Admin 2FA
ADMIN_TOTP_SECRET=replace_with_base32_totp_secret
KMS_PROVIDER=local
APP_MASTER_KEK=replace_with_a_random_64_character_hex_key
SUPER_ADMIN_ID=00000000-0000-0000-0000-000000000001
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Media worker & Sharp limits (run `npm run start:media-worker` as a separate service)
EMBEDDED_MEDIA_WORKER=false
MEDIA_WORKER_CONCURRENCY=1
MEDIA_WORKER_THREADS=1
SHARP_CONCURRENCY=1
SHARP_MAX_QUEUE=16

# Object Storage (S3 / Cloudflare R2; media ciphertext only)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=chatible-encrypted-vault
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
# Set true for S3-compatible stores requiring path-style URLs.
S3_FORCE_PATH_STYLE=false
