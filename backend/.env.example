# ==============================================================================
# Chatible Backend Environment Configuration (Production Template)
# ==============================================================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database (PostgreSQL 16)
# Run from the repository root to apply schema changes: npm run db:migrate
DATABASE_URL=postgresql://chatible_user:chatible_password@localhost:5432/chatible_db

# Cache & Real-time Queue (Redis 7)
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Admin access (generate a unique random value; do not use the placeholder)
ADMIN_SECRET_TOKEN=replace_with_a_unique_random_secret
# Mandatory Base32 TOTP secret (>= 16 chars) in production
ADMIN_TOTP_SECRET=replace_with_base32_totp_secret

# Media Processing & Dedicated Worker Supervision
EMBEDDED_MEDIA_WORKER=false
MEDIA_WORKER_CONCURRENCY=1
MEDIA_WORKER_THREADS=1
SHARP_CONCURRENCY=1
SHARP_MAX_QUEUE=16

# JWT Authentication (HS256 - Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# Local KMS Envelope Encryption Master Key (32-byte / 64-hex AES Key)
# Generate with: openssl rand -hex 32
# CRITICAL: Keep isolated outside DB. Back up securely.
APP_MASTER_KEK=replace_with_a_random_64_character_hex_key

# Super Admin Identity (Authorized for Report Evidence Adjudication)
SUPER_ADMIN_ID=00000000-0000-0000-0000-000000000001

# Object Storage (S3 / Cloudflare R2 for Media Ciphertext)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=chatible-encrypted-vault
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
# Set true for S3-compatible stores requiring path-style URLs.
S3_FORCE_PATH_STYLE=false
